{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "init-state/v1",
  "title": "WorkspaceInitState",
  "type": "object",
  "required": [
    "version",
    "session_id",
    "status",
    "current_step",
    "completed_steps",
    "context_data"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["in_progress", "completed", "aborted"]
    },
    "current_step": {
      "type": "string"
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skipped_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context_data": {
      "type": "object"
    },
    "started_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "elapsed_sec": {
      "type": "number"
    }
  }
}
