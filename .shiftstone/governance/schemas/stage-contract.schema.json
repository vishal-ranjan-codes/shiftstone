{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-workspace.local/schemas/stage-contract.schema.json",
  "title": "ICM Stage Contract (stage-contract/v1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "type",
    "stageId",
    "planId",
    "title",
    "status",
    "undeclaredInputPolicy",
    "inputs",
    "outputs",
    "verificationLevels",
    "exitCriteria"
  ],
  "properties": {
    "schemaVersion": { "const": "stage-contract/v1" },
    "type": { "const": "stage-contract" },
    "stageId": { "type": "string", "pattern": "^STAGE-[0-9]{2}(-[a-z0-9-]+)?$" },
    "planId": { "type": "string", "minLength": 3 },
    "title": { "type": "string", "minLength": 5 },
    "status": { "enum": ["planned", "in-progress", "completed", "blocked", "superseded"] },
    "undeclaredInputPolicy": { "const": "amend-and-reload" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role", "requiredStatus"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["ssot-bible", "decision", "research", "prior-stage-output", "skill", "schema"] },
          "requiredStatus": { "enum": ["active", "accepted", "completed"] }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "artifactType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "artifactType": { "enum": ["code", "schema", "test", "doc", "report", "migration"] }
        },
        "additionalProperties": false
      }
    },
    "verificationLevels": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["L1", "L1.5", "L2", "L3", "L4", "L5"] }
    },
    "exitCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "command", "expected"],
        "properties": {
          "id": { "type": "string", "pattern": "^EC-[0-9]{2}$" },
          "level": { "enum": ["L1", "L1.5", "L2", "L3", "L4", "L5"] },
          "command": { "type": "string", "minLength": 2 },
          "expected": { "type": "string", "minLength": 2 }
        },
        "additionalProperties": false
      }
    }
  }
}
