{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-workspace.local/schemas/plan-unit-v1.schema.json",
  "title": "Plan Unit Specification (plan-unit/v1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "unitId",
    "phaseId",
    "title",
    "layer",
    "status",
    "dependsOn",
    "requirementIds",
    "targetFiles",
    "acceptanceCriteria",
    "testScenarios",
    "verificationCommand",
    "confidenceScore"
  ],
  "properties": {
    "schemaVersion": { "const": "plan-unit/v1" },
    "unitId": { "type": "string", "pattern": "^U[0-9]{1,3}$" },
    "phaseId": { "type": "string", "pattern": "^phase-[0-9]+$" },
    "title": { "type": "string", "minLength": 5 },
    "layer": { "enum": ["core", "pack", "core+pack"] },
    "status": { "enum": ["planned", "in-progress", "completed", "blocked"] },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string", "pattern": "^U[0-9]{1,3}$" }
    },
    "requirementIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(UG|REQ|A|B|C|D)-[0-9]{1,3}$" }
    },
    "targetFiles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 2 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "requirementId", "criterion"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-U[0-9]{1,3}-[0-9]{1,2}$" },
          "requirementId": { "type": "string" },
          "criterion": { "type": "string", "minLength": 10 }
        },
        "additionalProperties": false
      }
    },
    "testScenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenarioId", "level", "description", "assertion"],
        "properties": {
          "scenarioId": { "type": "string", "pattern": "^TS-U[0-9]{1,3}-[0-9]{1,2}$" },
          "level": { "enum": ["L1", "L1.5", "L2", "L3", "L4"] },
          "description": { "type": "string", "minLength": 5 },
          "assertion": { "type": "string", "minLength": 5 }
        },
        "additionalProperties": false
      }
    },
    "verificationCommand": { "type": "string", "minLength": 3 },
    "confidenceScore": { "type": "number", "minimum": 0.8, "maximum": 1.0 }
  },
  "additionalProperties": false
}
