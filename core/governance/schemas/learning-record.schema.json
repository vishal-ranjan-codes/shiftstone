{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-workspace.local/schemas/learning-record.schema.json",
  "title": "Curated Learning Record (learning-record/v1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "learningId",
    "timestamp",
    "status",
    "category",
    "pack",
    "summary",
    "rootCause",
    "lesson",
    "evidencePaths",
    "promotionTargets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "learning-record/v1"
    },
    "learningId": {
      "type": "string",
      "pattern": "^LR-[0-9]{8}-[0-9]{3}$"
    },
    "timestamp": {
      "type": "string"
    },
    "status": {
      "enum": ["candidate", "validated", "promoted", "rejected"]
    },
    "category": {
      "enum": [
        "architecture",
        "security",
        "performance",
        "testing",
        "harness",
        "pack-domain"
      ]
    },
    "pack": {
      "type": "string",
      "minLength": 2
    },
    "summary": {
      "type": "string",
      "minLength": 5
    },
    "rootCause": {
      "type": "string",
      "minLength": 5
    },
    "lesson": {
      "type": "string",
      "minLength": 5
    },
    "evidencePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotionTargets": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "promotedByProposalId": {
      "type": "string",
      "pattern": "^SYNC-[0-9]{8}-[0-9]{3}$"
    },
    "rejectionReason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "promoted"
          }
        }
      },
      "then": {
        "required": ["promotedByProposalId"]
      }
    }
  ],
  "additionalProperties": false
}
