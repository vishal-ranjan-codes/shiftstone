{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-workspace.local/schemas/protected-action-approval.schema.json",
  "title": "Level 5 Protected Action Approval (protected-action-approval/v1)",
  "type": "object",
  "required": [
    "schemaVersion",
    "approvalId",
    "actionClass",
    "scopePaths",
    "gitTreeHash",
    "approver",
    "approvedAt",
    "expiresAt",
    "justification",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "protected-action-approval/v1"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^APR-[0-9]{8}-[0-9]{3}$"
    },
    "actionClass": {
      "enum": [
        "db-migration-destructive",
        "rls-policy-mutation",
        "auth-secret-rotation",
        "ssot-bible-mutation",
        "production-deploy",
        "core-governance-override"
      ]
    },
    "scopePaths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gitTreeHash": {
      "type": "string",
      "pattern": "(^[0-9a-f]{40}$|^workspace-head$)"
    },
    "approver": {
      "type": "string",
      "minLength": 2
    },
    "approvedAt": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string"
    },
    "justification": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "enum": ["active", "consumed", "expired", "revoked"]
    }
  },
  "additionalProperties": false
}
