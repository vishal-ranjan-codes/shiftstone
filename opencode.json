{
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "{{PACKAGE_MANAGER}} *": "allow",
      "*": "ask",
      "find *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "git log *": "allow",
      "git status": "allow",
      "git diff": "allow"
    },
    "external_directory": {
      "{{APP_PATH}}/**": "allow",
      "docs/**": "allow",
      "*": "deny"
    },
    "edit": "ask"
  },
  "mcp": {
    "github": {
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "type": "local",
      "enabled": true
    }
  },
  "instructions": [
    "AGENTS.md",
    ".shiftstone/static-rules/global.md",
    ".shiftstone/static-rules/product.md",
    ".shiftstone/static-rules/security.md",
    ".shiftstone/static-rules/verification.md",
    ".shiftstone/path-scoped-rules/structure.md",
    ".shiftstone/path-scoped-rules/code-quality.md",
    ".shiftstone/path-scoped-rules/ui-rules.md",
    ".shiftstone/path-scoped-rules/bible-rules.md",
    ".shiftstone/path-scoped-rules/research-rules.md"
  ]
}
