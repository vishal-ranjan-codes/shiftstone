node_modules/
.react-router/
.wrangler/
dist/
build/
.dev.vars
.env
.env.local
.env.*.local
*.log
.DS_Store
Thumbs.db
*.tsbuildinfo
coverage/
.turbo/

# Dual-Repo Monorepo Architecture: Nested Web Application (tracked in its own Git repository)
/apps/web/

# Workspace Git deployment metadata (contains local remote config & push status)
.workspace-git.json

# Command Code local settings override (never committed to git)
.commandcode/settings.local.json

# Shared skills directory junctions (created locally by core/scripts/setup-ide-junctions.js;
# .agents/skills holds the canonical view)
/.claude/skills
/.claude/skills/
/.commandcode/skills
/.commandcode/skills/

# Pack skill junctions (created locally by .shiftstone/scripts/link-ide-folders.js
# from .shiftstone/packs/<pack>/skills/; only core skills + the bundle's own record files
# are tracked in .agents/skills)
/.agents/skills/*
!/.agents/skills/ss-*/
!/.agents/skills/find-skills/
!/.agents/skills/log.md
!/.agents/skills/index.md

# IDE content junctions (created locally by core/scripts/link-ide-folders.js from core/)
/.agent/rules/
/.claude/rules/
/.commandcode/rules/

# Loop runtime state (specs are versioned in docs/loops/; state, baselines and runs are not)
.loops/

# Eval run results (suites are versioned in evals/<name>/; per-run results are not)
evals/runs.jsonl

# Agent pre-flight receipt (generated by agent-preflight.js)
.agent-preflight-receipt.json

# Workspace initialization receipt
.workspace-init-receipt.json

# Ephemeral runtime logs
.logs/


